FROM ubuntu/squid:6.6-24.04_edge@sha256:8a3baed477e2c282ab8aa5edad442f69873246964f225c5c2ae8364b6610963c
COPY infra/apt-security.sh /tmp/apt-security.sh
RUN sh /tmp/apt-security.sh && rm /tmp/apt-security.sh
COPY infra/squid.conf /etc/squid/squid.conf
USER 13:13
CMD ["/usr/sbin/squid", "-N", "-f", "/etc/squid/squid.conf"]
