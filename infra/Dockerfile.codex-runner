ARG TARGETARCH
ARG SABRE_CONTROL_IMAGE
FROM python:3.14.10-slim-bookworm@sha256:516b51cb9db2ef061e465c803e50f64361b82cefd91e525b889b967b83e83527 AS codex
FROM codex AS codex-amd64
ADD --checksum=sha256:62659fefd9a8efa21a496402fde3c11c025bbeee735a582968f8ffd14cb5f79c \
    https://registry.npmjs.org/@openai/codex/-/codex-0.164.0-linux-x64.tgz /tmp/codex.tgz
ENV CODEX_TRIPLE=x86_64-unknown-linux-musl
FROM codex AS codex-arm64
ADD --checksum=sha256:048a62731ce28aa000508efcc032302e58488ca079970dcae06d28df39ae5ce0 \
    https://registry.npmjs.org/@openai/codex/-/codex-0.164.0-linux-arm64.tgz /tmp/codex.tgz
ENV CODEX_TRIPLE=aarch64-unknown-linux-musl
FROM codex-${TARGETARCH} AS codex-selected
RUN --network=none python - <<'PY'
import hashlib
import os
import pathlib
import tarfile

executables = {
    "bin/codex": "b93f6811d3f653f0fb83be4050d857fb9abbb111dfa2ce160563327daff7f306",
    "bin/codex-code-mode-host": "8ee4f472e92ac226a189e98998633b2d07f989f208515750764db660369f2926",
    "codex-resources/bwrap": "3a81c19ad10a70436529c58e77898e2a447abe80167f813fc20ec34bd9eafdeb",
}
if os.environ['CODEX_TRIPLE'].startswith('aarch64'):
    executables = {
        'bin/codex': '8813c8d8a4cea2eeba271b72ab22f49628b184b24ab18dbef06b4ce41e9a8d39',
        'bin/codex-code-mode-host': '7d28b996b825b13ea058af67655b619a26a125d61d4fb2985694a9c4e77d2e21',
        'codex-resources/bwrap': '0d784834f1674ff02aee25b42f2cbcfd27c5305863806cd6475d0eac8e33c378',
    }
destination = pathlib.Path("/opt/codex")
with tarfile.open("/tmp/codex.tgz") as archive:
    for name, digest in executables.items():
        member = archive.getmember(f"package/vendor/{os.environ['CODEX_TRIPLE']}/{name}")
        assert member.isfile() and member.size < 536870912
        data = archive.extractfile(member).read()
        assert hashlib.sha256(data).hexdigest() == digest
        target = destination / name
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes(data)
        target.chmod(0o555)
PY
FROM ${SABRE_CONTROL_IMAGE}
USER 0:0
COPY --from=codex-selected /opt/codex/ /opt/codex/
COPY infra/licenses/ /usr/share/licenses/sabre-codex/
RUN chmod 0555 /opt/codex/bin/codex /opt/codex/bin/codex-code-mode-host /opt/codex/codex-resources/bwrap && mkdir -p /var/lib/sabre-codex && \
    chown 10001:10001 /var/lib/sabre-codex && chmod 0700 /var/lib/sabre-codex
ENV HOME=/var/lib/sabre-codex CODEX_HOME=/var/lib/sabre-codex
USER 10001:10001
EXPOSE 8091
CMD ["uvicorn", "sabre.codex_runner:create_app", "--factory", "--host", "0.0.0.0", "--port", "8091", "--no-access-log"]
