# SPDX-License-Identifier: Apache-2.0
# Scoped policy for the ephemeral native-check container; loaded by codex-apparmor-ci.sh.
# Based on Moby v28.0.4 profiles/apparmor/template.go, Apache-2.0.
# Bubblewrap 0.11.2 vendored by Codex commit 6aaac694803004a63c6f393d153c96d22521a6b9.
# Deliberately preserves Docker's non-mount policy. No attachment path: selected by Docker only.
#include <tunables/global>
@{SABRE_NEWROOT}=/newroot/ /newroot/**

profile @@SABRE_APPARMOR_PROFILE@@ flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  network,
  capability,
  file,
  umount,
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (send,receive) peer=@@SABRE_APPARMOR_PROFILE@@,
  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,
  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,
  ptrace (trace,read,tracedby,readby) peer=@@SABRE_APPARMOR_PROFILE@@,

  # Replace the default blanket mount denial with an allowlist. All other mounts stay denied.
  # Outer capabilities are still dropped by Docker; these permissions do not grant capabilities.
  mount options=(rw,rslave,silent) -> /,
  mount fstype=tmpfs options=(rw,nosuid,nodev) tmpfs -> /tmp/,
  mount options=(rw,rbind) /tmp/newroot/ -> /tmp/newroot/,
  pivot_root oldroot=/tmp/oldroot/ /tmp/,

  mount fstype=tmpfs options=(rw,nosuid,nodev) tmpfs -> @{SABRE_NEWROOT},
  mount fstype=proc options=(rw,nosuid,nodev,noexec) proc -> /newroot/proc/,
  mount fstype=devpts options=(rw,nosuid,noexec) devpts -> /newroot/dev/pts/,
  # Kernel AppArmor strips MS_SILENT and MS_MGC_VAL from bind mediation.
  mount options=(rw,rbind) /oldroot/** -> @{SABRE_NEWROOT},
  mount options=(rw,rbind) /bindfile?????? -> @{SABRE_NEWROOT},
  mount options=(rw,rbind) /newroot/proc/{sys/,sysrq-trigger,irq/,bus/} -> /newroot/proc/{sys/,sysrq-trigger,irq/,bus/},

  # Enumerated exact sets: never use 'options in', whose ro/rw behavior has documented bugs.
  # RO and NOSUID are mandatory in every set; this mirrors the reviewed seccomp mask.
  mount options=(ro,nosuid,remount,bind,silent) -> @{SABRE_NEWROOT},
  mount options=(ro,nosuid,remount,bind,silent,nodev) -> @{SABRE_NEWROOT},
  mount options=(ro,nosuid,remount,bind,silent,noexec) -> @{SABRE_NEWROOT},
  mount options=(ro,nosuid,remount,bind,silent,nodev,noexec) -> @{SABRE_NEWROOT},
  mount options=(ro,nosuid,remount,bind,silent,noatime) -> @{SABRE_NEWROOT},
  mount options=(ro,nosuid,remount,bind,silent,nodev,noatime) -> @{SABRE_NEWROOT},
  mount options=(ro,nosuid,remount,bind,silent,noexec,noatime) -> @{SABRE_NEWROOT},
  mount options=(ro,nosuid,remount,bind,silent,nodev,noexec,noatime) -> @{SABRE_NEWROOT},
  mount options=(ro,nosuid,remount,bind,silent,nodiratime) -> @{SABRE_NEWROOT},
  mount options=(ro,nosuid,remount,bind,silent,nodev,nodiratime) -> @{SABRE_NEWROOT},
  mount options=(ro,nosuid,remount,bind,silent,noexec,nodiratime) -> @{SABRE_NEWROOT},
  mount options=(ro,nosuid,remount,bind,silent,nodev,noexec,nodiratime) -> @{SABRE_NEWROOT},
  mount options=(ro,nosuid,remount,bind,silent,noatime,nodiratime) -> @{SABRE_NEWROOT},
  mount options=(ro,nosuid,remount,bind,silent,nodev,noatime,nodiratime) -> @{SABRE_NEWROOT},
  mount options=(ro,nosuid,remount,bind,silent,noexec,noatime,nodiratime) -> @{SABRE_NEWROOT},
  mount options=(ro,nosuid,remount,bind,silent,nodev,noexec,noatime,nodiratime) -> @{SABRE_NEWROOT},
  mount options=(ro,nosuid,remount,bind,silent,relatime) -> @{SABRE_NEWROOT},
  mount options=(ro,nosuid,remount,bind,silent,nodev,relatime) -> @{SABRE_NEWROOT},
  mount options=(ro,nosuid,remount,bind,silent,noexec,relatime) -> @{SABRE_NEWROOT},
  mount options=(ro,nosuid,remount,bind,silent,nodev,noexec,relatime) -> @{SABRE_NEWROOT},
  mount options=(ro,nosuid,remount,bind,silent,noatime,relatime) -> @{SABRE_NEWROOT},
  mount options=(ro,nosuid,remount,bind,silent,nodev,noatime,relatime) -> @{SABRE_NEWROOT},
  mount options=(ro,nosuid,remount,bind,silent,noexec,noatime,relatime) -> @{SABRE_NEWROOT},
  mount options=(ro,nosuid,remount,bind,silent,nodev,noexec,noatime,relatime) -> @{SABRE_NEWROOT},
  mount options=(ro,nosuid,remount,bind,silent,nodiratime,relatime) -> @{SABRE_NEWROOT},
  mount options=(ro,nosuid,remount,bind,silent,nodev,nodiratime,relatime) -> @{SABRE_NEWROOT},
  mount options=(ro,nosuid,remount,bind,silent,noexec,nodiratime,relatime) -> @{SABRE_NEWROOT},
  mount options=(ro,nosuid,remount,bind,silent,nodev,noexec,nodiratime,relatime) -> @{SABRE_NEWROOT},
  mount options=(ro,nosuid,remount,bind,silent,noatime,nodiratime,relatime) -> @{SABRE_NEWROOT},
  mount options=(ro,nosuid,remount,bind,silent,nodev,noatime,nodiratime,relatime) -> @{SABRE_NEWROOT},
  mount options=(ro,nosuid,remount,bind,silent,noexec,noatime,nodiratime,relatime) -> @{SABRE_NEWROOT},
  mount options=(ro,nosuid,remount,bind,silent,nodev,noexec,noatime,nodiratime,relatime) -> @{SABRE_NEWROOT},

  mount options=(rw,rprivate,silent) -> /oldroot/,
  pivot_root oldroot=/newroot/ /newroot/,

  # Positive syscall oracle only, at the native suite's fixed basetemp; sibling 'forbidden' stays denied.
  mount fstype=tmpfs options=(rw,nosuid,nodev) tmpfs -> /tmp/sabre-codex-policy/test_outer_privileges*/allowed/,
}
