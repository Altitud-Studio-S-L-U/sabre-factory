FROM ghcr.io/astral-sh/uv:0.13.4@sha256:9f130421e930bfbdc563c00740466603f8723158e90297d07957c2294640262b AS uv
FROM node:24.22.2-bookworm-slim@sha256:c86ecead9e55a5210ac1727de38a4ca840bf03dcaf34dc9749addbf383b1920c AS web
WORKDIR /web
RUN npm install --global --ignore-scripts pnpm@11.19.0
COPY web/package.json web/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY web ./
RUN pnpm build

FROM python:3.14.10-slim-bookworm@sha256:516b51cb9db2ef061e465c803e50f64361b82cefd91e525b889b967b83e83527 AS base
COPY --from=uv /uv /uvx /usr/local/bin/
ENV UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never UV_EXCLUDE_NEWER=2026-10-29T00:00:00Z PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 PATH="/app/.venv/bin:$PATH"
WORKDIR /app

FROM base AS lock
COPY backend /app

FROM base AS dev
COPY backend/pyproject.toml backend/uv.lock ./
RUN --mount=type=cache,id=sabre-factory-uv,target=/root/.cache/uv uv sync --frozen --no-install-project
COPY backend /app
RUN --mount=type=cache,id=sabre-factory-uv,target=/root/.cache/uv uv sync --frozen
CMD ["uv", "run", "--no-sync", "pytest"]

FROM base AS runtime
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY backend/src ./src
COPY infra/rules /rules
COPY infra/import-legacy.py /app/operations/import-legacy.py
COPY --from=web /web/dist /app/web/dist
RUN uv sync --frozen --no-dev && \
    groupadd --gid 10001 sabre && useradd --uid 10001 --gid sabre --no-create-home sabre && \
    mkdir -p /var/lib/sabre /workspaces && chown -R sabre:sabre /var/lib/sabre && chmod 0700 /workspaces
USER 10001:10001
EXPOSE 8000
CMD ["uvicorn", "sabre.api:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
